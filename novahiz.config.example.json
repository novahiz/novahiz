{
  "dbPath": "novahiz.sqlite",
  "skillRoots": [
    "~/.config/opencode/skills",
    "~/.agents/skills",
    "~/.config/.agents/skills",
    "~/.config/marketingskills/skills",
    "~/.config/humanizer"
  ],
  "gate": {
    "enabled": true,
    "mode": "block",
    "envEscape": "NOVAHIZ_GATE",
