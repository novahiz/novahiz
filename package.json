{
  "name": "skillenforce",
  "version": "0.2.1",
  "description": "Enforce AI agent skills before every file edit: prompt classifier, skill catalog, and pre-edit gate.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Skillenforce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillenforce/skillenforce.git"
  },
  "homepage": "https://github.com/skillenforce/skillenforce#readme",
  "bugs": {
    "url": "https://github.com/skillenforce/skillenforce/issues"
  },
  "keywords": [
    "ai-agents",
    "agentic",
    "deterministic",
    "opencode",
    "skills",
    "mcp",
    "enforcement",
    "gate"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skillenforce": "./bin/skillenforce.mjs",
    "skillenforce-bootstrap": "./install/bootstrap.mjs",
    "skillenforce-install": "./install/install.mjs",
    "skillenforce-uninstall": "./install/uninstall.mjs",
    "skillenforce-mcp": "./mcp/skillenforce-tools/index.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "node src/cli.ts check",
    "sync": "node src/cli.ts sync",
    "classify": "node src/cli.ts classify",
    "catalog": "node src/cli.ts catalog",
    "report": "node src/cli.ts report",
    "setup": "node install/install.mjs",
    "setup:dry": "node install/install.mjs --dry-run",
    "bootstrap": "node install/bootstrap.mjs",
    "bootstrap:dry": "node install/bootstrap.mjs --dry-run",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "catalog",
    "adapters",
    "bin",
    "install",
    "mcp",
    "skills",
    "bundled-skills",
    "docs",
    "README.md",
    "NOTICE.md",
    "skillenforce.config.example.json",
    "tsconfig.json",
    "LICENSE"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
