{
  "name": "novahiz",
  "version": "0.1.0",
  "description": "Deterministic agentic layer for coding harnesses: skill catalog, prompt classifier, and a pre-edit enforcement gate.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Novahiz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novahiz/novahiz.git"
  },
  "homepage": "https://github.com/novahiz/novahiz#readme",
  "bugs": {
    "url": "https://github.com/novahiz/novahiz/issues"
  },
  "keywords": [
    "ai-agents",
    "agentic",
    "deterministic",
    "opencode",
    "claude-code",
    "codex",
    "skills",
    "mcp",
    "enforcement",
    "gate"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "novahiz": "./bin/novahiz.mjs",
    "novahiz-install": "./install/install.mjs",
    "novahiz-uninstall": "./install/uninstall.mjs",
    "novahiz-mcp": "./mcp/novahiz-tools/index.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "node src/cli.ts check",
    "sync": "node src/cli.ts sync",
    "classify": "node src/cli.ts classify",
    "catalog": "node src/cli.ts catalog",
    "report": "node src/cli.ts report",
    "setup": "node install/install.mjs",
    "setup:dry": "node install/install.mjs --dry-run",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "catalog",
    "adapters",
    "bin",
    "install",
    "mcp",
    "skills",
    "docs",
    "README.md",
    "NOTICE.md",
    "novahiz.config.example.json",
    "tsconfig.json",
    "LICENSE"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
