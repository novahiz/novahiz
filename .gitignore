# Local state — not part of any published package
novahiz.sqlite
novahiz.sqlite-*
novahiz.sqlite.stale-*
Novahiz.sqlite
Novahiz.sqlite-*
*.novahiz-bak
build/
node_modules/
*.log
.env
*.tgz

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
# graft.exe's local VCS store (SQLite) — machine data, like novahiz.sqlite.
/.graft/
# novahiz snap — the ledger snapshot store (machine data: gzip objects, manifests,
# backups), regenerable by capture, like novahiz.sqlite itself.
/.snap/
# build output of `npm run prepare` (tsc -p tsconfig.build.json) — regenerated.
/dist/
# agent session memory — machine data, regenerated as the session runs.
/project-memory/
# local pre-migration copy of the opencode plugin — not part of the source.
*.pre-v2
