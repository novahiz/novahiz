[
  {
    "id": "R1-code-prose",
    "description": "Load humanizer when code or design changes contain prose, and fix any AI writing pattern immediately (not-X-but-Y contrasts, forced triads, excessive dashes, empty phrases, marketing jargon, superlatives).",
    "when": {
      "fileClasses": [
        "code",
        "design"
      ],
      "contentMatches": [
        "prose"
      ]
    },
    "require": [
      "humanizer"
    ]
  },
  {
    "id": "R1-docs",
    "description": "Load humanizer on text, documentation, and written content.",
    "when": {
      "fileClasses": [
        "text",
        "data",
        "config"
      ],
      "promptCategories": [
        "docs-writing"
      ]
    },
    "require": [
      "humanizer"
    ]
  },
  {
    "id": "R2-style",
    "description": "Load impeccable on visual style files.",
    "when": {
      "pathGlobs": [
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.styl",
        "**/*.html",
        "**/*.vue",
        "**/*.svelte",
        "**/*.astro"
      ]
    },
    "require": [
      "impeccable"
    ]
  },
  {
    "id": "R2-styled-component",
    "description": "Load impeccable on components whose changes touch styling.",
    "when": {
      "pathGlobs": [
        "**/*.jsx",
        "**/*.tsx"
      ],
      "contentMatches": [
        "style"
      ]
    },
    "require": [
      "impeccable"
    ]
  },
  {
    "id": "R3-supabase",
    "description": "Load Supabase skills on any Supabase task.",
    "when": {
      "pathGlobs": [
        "**/supabase/**",
        "**/migrations/**"
      ],
      "promptCategories": [
        "database-supabase"
      ]
    },
    "require": [
      "supabase",
      "supabase-postgres-best-practices"
    ]
  },
  {
    "id": "R4-playwright",
    "description": "Load playwright-agent on any task using Playwright or navigating to a local server.",
    "when": {
      "promptCategories": [
        "browser"
      ]
    },
    "require": [
      "playwright-agent"
    ]
  },
  {
    "id": "R5-design",
    "description": "When working on a design or UI task, load the impeccable skill and follow its workflow.",
    "when": {
      "promptCategories": [
        "design-ui"
      ]
    },
    "require": [
      "impeccable"
    ]
  }
]
