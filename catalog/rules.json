[
  {
    "id": "R3-supabase",
    "description": "Load Supabase skills on any Supabase task.",
    "when": {
      "match": "any",
      "pathGlobs": ["**/supabase/**", "**/migrations/**"],
      "promptCategories": ["database-supabase"]
    },
    "require": ["novahiz-supabase", "novahiz-postgres"]
  },
  {
    "id": "R4-playwright",
    "description": "Load novahiz-browser on any task using Playwright or targeting browser tests.",
    "when": {
      "match": "any",
      "promptCategories": ["browser"],
      "pathGlobs": [
        "**/*.e2e.ts",
        "**/*.e2e.js",
        "**/*.pw.ts",
        "**/e2e/**",
        "**/playwright/**",
        "**/*.cy.ts"
      ]
    },
    "require": ["novahiz-browser"]
  },
  {
    "id": "R6-Novahiz",
    "description": "Load Novahiz pipeline skills for any task triggering the workflow.",
    "when": {
      "promptCategories": [
        "code",
        "debug",
        "review",
        "audit",
        "browser",
        "design-ui",
        "database-supabase",
        "docs-writing",
        "planning",
        "devops",
        "data",
        "general",
        "flutter",
        "expo",
        "test"
      ]
    },
    "require": ["novahiz-plan", "novahiz-clarify", "novahiz-analyse", "novahiz-implement", "novahiz-converge"]
  },
  {
    "id": "R7-assessment",
    "description": "Load Idea Assessment pipeline skills.",
    "when": {
      "promptCategories": ["assessment"]
    },
    "require": ["novahiz-assess-intake", "novahiz-assess-research", "novahiz-assess-define", "novahiz-assess-shape", "novahiz-assess-decide"]
  },
  {
    "id": "R8-docs",
    "description": "Load novahiz-docs when editing project documentation (docs tree, README/CHANGELOG, or a docs-writing prompt).",
    "when": {
      "match": "any",
      "pathGlobs": ["**/novahiz-docs/**/*.md", "**/docs/**/*.md", "**/README.md", "**/CHANGELOG.md"],
      "promptCategories": ["docs-writing"]
    },
    "require": ["novahiz-docs"]
  },
  {
    "id": "R9-code-review",
    "description": "Load novahiz-code-review on code review tasks or code edits of 200+ characters (small touch-ups skip the review).",
    "when": {
      "match": "any",
      "promptCategories": ["review"],
      "fileClasses": ["code"],
      "pathGlobs": ["**/*.tsx", "**/*.jsx", "**/*.vue", "**/*.svelte", "**/*.astro"],
      "minChange": 200
    },
    "require": ["novahiz-code-review"]
  },
  {
    "id": "R10-security",
    "description": "Load novahiz-security on any security audit or hardening task.",
    "when": {
      "match": "any",
      "promptCategories": ["audit"]
    },
    "require": ["novahiz-security"]
  },
  {
    "id": "R11-accessibility",
    "description": "Load novahiz-wcag-audit on design-ui work and on audit prompts, where accessibility is in scope.",
    "when": {
      "match": "any",
      "promptCategories": ["design-ui", "audit"]
    },
    "require": ["novahiz-wcag-audit"]
  },
  {
    "id": "R12-web-extract",
    "description": "Load novahiz-web-extract when fetching web content.",
    "when": {
      "match": "any",
      "promptCategories": ["research"]
    },
    "require": ["novahiz-web-extract"]
  },
  {
    "id": "R13-design-craft",
    "description": "Load novahiz-humanizer, ui-slop-remover and ui-craft-rules on frontend design tasks only.",
    "when": {
      "match": "any",
      "promptCategories": ["design-ui"],
      "pathGlobs": [
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.html",
        "**/*.htm"
      ],
      "minChange": 200
    },
    "require": ["novahiz-humanizer", "ui-slop-remover", "ui-craft-rules"]
  },
  {
    "id": "R14-impeccable",
    "description": "Load the impeccable design skill on frontend design tasks so critique/audit/polish playbooks stay available.",
    "when": {
      "match": "any",
      "promptCategories": ["design-ui"],
      "pathGlobs": [
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.html",
        "**/*.htm"
      ],
      "minChange": 200
    },
    "require": ["impeccable"]
  },
  {
    "id": "R15-token-economy",
    "description": "Load token-economy when editing the token-economy feature itself, where its contract (opt-in switch, budgets, 3.2 bytes/token, full-output dump) is prerequisite knowledge.",
    "when": {
      "match": "any",
      "pathGlobs": [
        "**/novahiz-token-economy.ts",
        "**/skills/token-economy/**",
        "**/tests/token-economy.test.ts",
        "**/docs/TOKENS.md"
      ]
    },
    "require": ["token-economy"]
  },
  {
    "id": "R16-stitch-fidelity",
    "description": "Load novahiz-stitch-fidelity before editing the UI of a project that carries Stitch references (stitch/**): capture, composite and fidelity verdict must be part of that loop.",
    "when": {
      "match": "all",
      "pathGlobs": [
        "**/*.tsx",
        "**/*.jsx",
        "**/*.vue",
        "**/*.svelte",
        "**/*.dart",
        "**/*.css",
        "**/*.scss",
        "**/*.html"
      ],
      "projectGlobs": ["stitch/**"]
    },
    "require": ["novahiz-stitch-fidelity"]
  },
  {
    "id": "R17-wireframe",
    "description": "Load novahiz-wireframe on any design-ui task or on any screen/view/component file: the wireframe-first sequence (screen sketch + per-section annotated wireframes feeding impeccable shape) is mandatory before constructing a screen or section. It is skipped only for micro-changes - the rule applies from 800 characters of change, at lite or full complexity, so touching an existing screen never demands a wireframe.",
    "when": {
      "match": "any",
      "promptCategories": ["design-ui"],
      "pathGlobs": [
        "**/wireframes/**",
        "**/screens/**",
        "**/pages/**",
        "**/views/**",
        "**/routes/**",
        "**/app/**",
        "**/components/**"
      ],
      "tiers": ["lite", "full"],
      "minChange": 800
    },
    "require": ["novahiz-wireframe"]
  },
  {
    "id": "R18-skill-craft",
    "description": "Load novahiz-skill-craft before creating or modifying any skill: the frontmatter contract, the progressive disclosure, the lifecycle (create/evaluate/improve/audit) and the gate rules it must satisfy apply to every SKILL.md edit.",
    "when": {
      "match": "any",
      "pathGlobs": [
        "**/skills/**/SKILL.md",
        "**/skills/**/*.md",
        "**/skills/**/*.py",
        "**/skills/**/*.mjs",
        "**/skills/**/*.json"
      ]
    },
    "require": ["novahiz-skill-craft"]
  }
]
