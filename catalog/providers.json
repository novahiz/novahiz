[
  {
    "id": "playwright",
    "label": "Playwright MCP",
    "kind": "mcp",
    "command": ["npx", "-y", "@playwright/mcp@latest"],
    "source": "https://github.com/microsoft/playwright-mcp",
    "license": "Apache-2.0",
    "categories": ["browser", "design-ui"]
  },
  {
    "id": "security",
    "label": "Security MCP",
    "kind": "mcp",
    "command": ["npx", "-y", "security-mcp@latest", "serve"],
    "source": "https://github.com/AbrahamOO/security-mcp",
    "license": "MIT",
    "categories": ["audit"]
  },
  {
    "id": "narsil",
    "label": "Narsil Code Intelligence",
    "kind": "mcp",
    "command": ["npx", "-y", "narsil-mcp@latest", "--repos", "."],
    "source": "https://github.com/postrv/narsil-mcp",
    "license": "MIT OR Apache-2.0",
    "categories": ["code", "review"]
  },
  {
    "id": "context7",
    "label": "Context7 Documentation",
    "kind": "mcp",
    "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
    "source": "https://github.com/upstash/context7",
    "license": "MIT",
    "categories": ["code"]
  },
  {
    "id": "cron",
    "label": "Cron Scheduler",
    "kind": "mcp",
    "command": ["C:/Users/hiz/.local/share/mcp-scheduler/.venv/Scripts/python.exe", "C:/Users/hiz/.local/share/mcp-scheduler/main.py"],
    "source": "https://github.com/PhialsBasement/scheduler-mcp",
    "license": "MIT",
    "categories": ["devops"],
    "purpose": "Local MIT scheduler clone at C:/Users/hiz/.local/share/mcp-scheduler (requirements pin mcp<2)."
  },
  {
    "id": "novahiz",
    "label": "novahiz",
    "kind": "mcp",
    "command": ["node", "C:/Users/hiz/.config/novahiz/mcp/novahiz-tools/index.mjs"],
    "source": "https://github.com/novahiz/novahiz",
    "license": "Apache-2.0",
    "categories": ["code", "planning"]
  },
  {
    "id": "dart",
    "label": "Dart / Flutter MCP",
    "kind": "mcp",
    "command": ["dart", "mcp-server"],
    "requires": ["dart"],
    "source": "https://github.com/dart-lang/ai/tree/main/pkgs/dart_mcp_server",
    "license": "BSD-3-Clause",
    "categories": ["code", "debug", "design-ui", "flutter"],
    "purpose": "Official Dart SDK MCP: analyzer diagnostics, symbols, test launch, runtime inspection."
  },
  {
    "id": "flutter-skills",
    "label": "Flutter agent skills",
    "kind": "skill",
    "install": ["npx", "-y", "skills", "add", "flutter/agent-plugins", "--skill", "*", "-g", "-a", "opencode", "-y"],
    "source": "https://github.com/flutter/agent-plugins",
    "license": "BSD-3-Clause",
    "categories": ["code", "design-ui", "flutter"],
    "purpose": "25 official Flutter/Dart agent skills (layouts, tests, architecture, routing, l10n)."
  },
  {
    "id": "dart-skills",
    "label": "Dart agent skills",
    "kind": "skill",
    "install": ["npx", "-y", "skills", "add", "dart-lang/skills", "--skill", "*", "-g", "-a", "opencode", "-y"],
    "source": "https://github.com/dart-lang/skills",
    "license": "BSD-3-Clause",
    "categories": ["code", "debug", "flutter"],
    "purpose": "15 official Dart skills (subset of flutter/agent-plugins, kept for provenance)."
  },
  {
    "id": "expo-skills",
    "label": "Expo agent skills",
    "kind": "skill",
    "install": ["npx", "-y", "skills", "add", "expo/skills", "--skill", "expo-overview", "expo-project-structure", "expo-router", "expo-animation", "expo-native-ui", "expo-design-system", "expo-ui", "expo-data-fetching", "expo-dom", "expo-web-to-native", "expo-module", "expo-brownfield", "expo-dev-client", "expo-examples", "expo-app-clip", "expo-upgrade", "expo-skill-feedback", "-g", "-a", "opencode", "-y"],
    "source": "https://github.com/expo/skills",
    "license": "MIT",
    "categories": ["code", "expo"],
    "purpose": "17 official Expo framework skills (expo-* group); the 7 eas-* paid-service skills are excluded. Installed to ~/.agents/skills; when git clone fails, fetch the tarball from codeload.github.com and copy the skill folders."
  }
]
