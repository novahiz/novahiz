[
  {
    "id": "playwright",
    "label": "Playwright browser",
    "kind": "mcp",
    "transport": "local",
    "command": ["npx", "-y", "@playwright/mcp@latest"],
    "install": ["npx", "-y", "@playwright/mcp@latest", "--help"],
    "requires": ["npx"],
    "purpose": "Navigate, screenshot, and interact with web pages in a real browser.",
    "categories": ["browser", "design-ui"],
    "source": "https://github.com/microsoft/playwright-mcp",
    "license": "Apache-2.0"
  },
  {
    "id": "security",
    "label": "Security scanner",
    "kind": "mcp",
    "transport": "local",
    "command": ["npx", "-y", "security-mcp", "serve"],
    "install": ["npx", "-y", "security-mcp", "--version"],
    "requires": ["npx"],
    "purpose": "SAST and DAST scans, OWASP and CWE coverage, compliance mapping.",
    "categories": ["audit"],
    "source": "https://github.com/AbrahamOO/security-mcp",
    "license": "MIT"
  },
  {
    "id": "narsil",
    "label": "Code intelligence",
    "kind": "mcp",
    "transport": "local",
    "command": ["npx", "-y", "narsil-mcp@latest", "--repos", ".", "--git"],
    "install": ["npx", "-y", "narsil-mcp@latest", "--help"],
    "requires": ["npx"],
    "purpose": "Code graph, symbols, taint tracking, dead code, and security scan.",
    "categories": ["code", "debug", "review", "audit"],
    "source": "https://github.com/postrv/narsil-mcp",
    "license": "MIT OR Apache-2.0"
  },
  {
    "id": "context7",
    "label": "Library docs",
    "kind": "mcp",
    "transport": "local",
    "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
    "install": ["npx", "-y", "@upstash/context7-mcp@latest", "--help"],
    "requires": ["npx"],
    "purpose": "Up-to-date documentation for libraries, frameworks, and SDKs.",
    "categories": ["code", "research"],
    "source": "https://github.com/upstash/context7",
    "license": "MIT"
  },
  {
    "id": "sequential-thinking",
    "label": "Structured reasoning",
    "kind": "mcp",
    "transport": "local",
    "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
    "install": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking", "--help"],
    "requires": ["npx"],
    "purpose": "Step-by-step reasoning for planning, debugging, and audits.",
    "categories": ["planning", "debug", "audit"],
    "source": "https://github.com/modelcontextprotocol/servers",
    "license": "MIT"
  },
  {
    "id": "cron",
    "label": "Scheduler",
    "kind": "mcp",
    "transport": "local",
    "command": ["npx", "-y", "mcp-cron", "--transport", "stdio"],
    "install": ["npx", "-y", "mcp-cron", "--help"],
    "requires": ["npx"],
    "purpose": "Schedule and run recurring or delayed tasks.",
    "categories": ["devops", "general"],
    "source": "https://github.com/jolks/mcp-cron",
    "license": "AGPL-3.0-only"
  },
  {
    "id": "impeccable",
    "label": "Impeccable design skill",
    "kind": "skill",
    "install": ["npx", "-y", "impeccable", "install", "--providers=opencode", "--scope=global"],
    "requires": ["npx"],
    "purpose": "Design skill and commands for frontend interfaces.",
    "categories": ["design-ui"],
    "source": "https://github.com/pbakaus/impeccable",
    "license": "Apache-2.0"
  },
  {
    "id": "speckit",
    "label": "Spec Kit commands",
    "kind": "commands",
    "install": ["uv", "tool", "install", "specify-cli"],
    "requires": ["uv"],
    "bootstrap": {
      "win32": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://astral.sh/uv/install.ps1 | iex\"",
      "default": "sh -c \"curl -LsSf https://astral.sh/uv/install.sh | sh\""
    },
    "purpose": "Spec-driven development commands (specify, plan, tasks, implement).",
    "categories": ["planning", "code"],
    "source": "https://github.com/github/spec-kit",
    "license": "MIT"
  }
]
